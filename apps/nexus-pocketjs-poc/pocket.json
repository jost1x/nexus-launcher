{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.r36s.nexus.pocketjs-poc",
  "name": "nexus-pocketjs-poc",
  "title": "NEXUS PocketJS PoC",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["text.glyphs.baked", "input.buttons"]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "nexus-pocketjs-poc-main",
    "framework": "solid",
    "viewport": {
      "fixed": {
        "logical": [640, 480],
        "presentation": "native"
      }
    }
  }
}
